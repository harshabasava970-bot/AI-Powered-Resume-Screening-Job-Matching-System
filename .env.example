# ============================================================
# Environment Variables — Copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/resume_screening_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- Server ---
SERVER_PORT=8080

# --- Security ---
APP_SECRET=replace-with-a-random-32-plus-character-secret-string

# --- File Upload ---
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# --- JPA ---
JPA_DDL_AUTO=update

# --- Docker Compose MySQL (used only in docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=resume_screening_db
MYSQL_USER=appuser
MYSQL_PASSWORD=your_app_password
